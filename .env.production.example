# AI Data Steward — production configuration template
# Copy to .env.production and replace every CHANGE_ME value.
# Do not commit .env.production.

# Public edge
# Before you own a domain, validate locally with:
#   APP_SITE_ADDRESS=http://localhost
#   HTTP_PORT=8080
#   HTTPS_PORT=8443
#
# When your DNS A/AAAA record points to this server, change to:
#   APP_SITE_ADDRESS=steward.example.com
#   HTTP_PORT=80
#   HTTPS_PORT=443
APP_SITE_ADDRESS=http://localhost
HTTP_PORT=8080
HTTPS_PORT=8443
# Optional. To give the certificate authority a contact address, add an
# "email you@example.gov" line to deploy/caddy/Caddyfile; an empty or
# placeholder value is rejected when the certificate is issued.
ACME_EMAIL=

# Application-origin settings must match the browser-visible URL.
PUBLIC_APP_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080
TRUSTED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

POSTGRES_DB=ai_data_steward
POSTGRES_USER=steward
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD

# Self-hosted MVP authentication.
AUTH_MODE=local
AUTH_SECRET_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
AUTH_TOKEN_HOURS=8
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_MINUTES=15
# Trusted reverse proxies in front of the app (Caddy -> nginx -> app = 2). The
# sign-in throttle reads the client address this many entries from the end of
# X-Forwarded-For. Never set it higher than the real number of proxies.
AUTH_TRUSTED_PROXY_HOPS=2

CATALOG_PUBLISHER=mock
CKAN_BASE_URL=
CKAN_API_KEY=
CKAN_OWNER_ORG=

TESTGEN_MODE=real
TESTGEN_BASE_URL=http://host.docker.internal:8530
TESTGEN_AUTH_MODE=oauth_refresh
TESTGEN_TOKEN=
TESTGEN_OAUTH_CLIENT_ID=
TESTGEN_OAUTH_CLIENT_SECRET=
TESTGEN_OAUTH_REFRESH_TOKEN=
TESTGEN_PROJECT_CODE=
TESTGEN_TABLE_GROUP_ID=
TESTGEN_TEST_SUITE_ID=


# Operations
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
BACKUP_RETENTION_DAYS=14
# Install the nightly backup timer with: sudo scripts/install_backup_timer.sh
# BACKUP_DIR and BACKUP_RETENTION_DAYS are read by the timer from .env.backup.
