# AI Data Steward — public domain example
# Copy values into .env.production after your domain is purchased and its
# DNS A/AAAA record points to the self-hosted server.

APP_SITE_ADDRESS=steward.example.com
HTTP_PORT=80
HTTPS_PORT=443
ACME_EMAIL=admin@example.com

PUBLIC_APP_URL=https://steward.example.com
CORS_ORIGINS=https://steward.example.com
# localhost and 127.0.0.1 are always trusted in addition to this list, because
# the container health checks call the app on the loopback address.
TRUSTED_HOSTS=steward.example.com

# Keep all existing database/auth/TestGen secrets from .env.production.
# Do not replace AUTH_SECRET_KEY or POSTGRES_PASSWORD during a domain change.
